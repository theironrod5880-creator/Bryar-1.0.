# Copy to .env. Never commit .env or real secrets.
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
AI_API_KEY=
# Optional OpenAI-compatible chat completions endpoint:
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Keep false until you have reviewed your legal/privacy requirements and ad provider.
ADS_ENABLED=false
# Only use a trusted HTTPS URL for your chosen ad provider's script, after review.
AD_SCRIPT_URL=
# WebRTC STUN server. TURN is recommended for production; configure your own provider.
STUN_URL=stun:stun.l.google.com:19302
